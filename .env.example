APP_NAME=CodeTeam Agent API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./codeteam.db
REPOSITORY_ROOT=./data/repositories
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
TASK_DISPATCH_MODE=local
AGENT_MAX_RETRIEVAL_ATTEMPTS=2
AGENT_MAX_REVISION_ATTEMPTS=2
SANDBOX_ROOT=./data/sandboxes
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_ALLOWED_COMMANDS=pytest,ruff
